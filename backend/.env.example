# ─── Serveur ───────────────────────────────────────────────────────────────
PORT=5000

# ─── Base de données ────────────────────────────────────────────────────────
# URI de connexion MongoDB Atlas
URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT ────────────────────────────────────────────────────────────────────
# Clé secrète JWT pour les tokens utilisateurs (minimum 32 caractères)
JWT_SECRET=change-me-with-a-strong-secret-2026!

# Clé secrète JWT pour les tokens du portail clients (module DI)
JWT_CLIENT_SECRET=change-me-client-secret-2026!

# ─── Sécurité ───────────────────────────────────────────────────────────────
# Clé de hashage des mots de passe (crypto-js AES)
PASSWORD_SECRET=change-me-password-hash-secret-2026!

# Clé secrète pour express-session
SESSION_SECRET=change-me-session-secret-2026!

# ─── Emails (SMTP Gmail) ────────────────────────────────────────────────────
# Email expéditeur (Gmail)
SMTP_USER=votre-app@gmail.com

# Mot de passe d'application Gmail (pas le mot de passe du compte)
# Générer sur : https://myaccount.google.com/apppasswords
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# ─── CORS ───────────────────────────────────────────────────────────────────
# URL principale du frontend (ajoutée à la liste blanche CORS)
FRONTEND_URL=https://votre-app.vercel.app

# URL alternative frontend (domaine custom si différent)
CLIENT_URL=https://www.votre-domaine.com

# ─── Environnement ──────────────────────────────────────────────────────────
NODE_ENV=development
