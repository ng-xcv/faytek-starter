# ─── Serveur ───────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Base de données (OBLIGATOIRE) ─────────────────────────────────────────
# URI de connexion MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT (OBLIGATOIRES — le serveur crash si absents) ──────────────────────
# Clé access token (15 min) — générer : openssl rand -base64 64
JWT_SECRET=change-me-with-a-strong-secret-min-64-chars
# Clé refresh token (7 j) — DOIT être différente de JWT_SECRET
JWT_REFRESH_SECRET=change-me-with-a-DIFFERENT-strong-secret-min-64-chars
# Clé JWT portail clients DI (si module DI utilisé)
JWT_CLIENT_SECRET=change-me-client-secret-min-64-chars

# ─── Sécurité (OBLIGATOIRE) ────────────────────────────────────────────────
# Clé secrète pour express-session
SESSION_SECRET=change-me-session-secret-min-64-chars

# ─── Emails (SMTP Gmail) ────────────────────────────────────────────────────
SMTP_USER=votre-app@gmail.com
# Mot de passe d'application Gmail (https://myaccount.google.com/apppasswords)
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# ─── Cloudinary (uploads médias) ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=change-me-cloudinary-secret

# ─── CORS ───────────────────────────────────────────────────────────────────
# URL principale du frontend (ajoutée à la liste blanche CORS)
FRONTEND_URL=https://votre-app.vercel.app
# URL alternative frontend (domaine custom si différent)
CLIENT_URL=https://www.votre-domaine.com
